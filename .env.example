# =============================================================================
# SkillForge environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# All secrets are read from environment variables only.
# =============================================================================

# ---- AI Provider ----
# One of: mock | openai-compatible | ollama-local | anthropic | gemini | cohere
SKILLFORGE_AI_PROVIDER=mock

# ---- OpenAI-compatible provider ----
# (OpenAI, OpenRouter, Groq, Together, Mistral, DeepSeek, xAI, Fireworks, Z.ai…)
SKILLFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
SKILLFORGE_OPENAI_API_KEY=your_api_key_here
SKILLFORGE_MODEL=gpt-4.1

# ---- Anthropic (Claude) ----
SKILLFORGE_ANTHROPIC_BASE_URL=https://api.anthropic.com
SKILLFORGE_ANTHROPIC_API_KEY=
# Set SKILLFORGE_MODEL to a Claude model, e.g. claude-3-5-sonnet-latest

# ---- Google Gemini ----
SKILLFORGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
SKILLFORGE_GEMINI_API_KEY=
# Set SKILLFORGE_MODEL to a Gemini model, e.g. gemini-2.0-flash

# ---- Cohere ----
SKILLFORGE_COHERE_BASE_URL=https://api.cohere.com
SKILLFORGE_COHERE_API_KEY=
# Set SKILLFORGE_MODEL to a Cohere model, e.g. command-r-plus

# ---- Ollama (local LLM) ----
SKILLFORGE_OLLAMA_BASE_URL=http://localhost:11434
# When using ollama, set SKILLFORGE_MODEL to a pulled model e.g. llama3.1
# SKILLFORGE_MODEL=llama3.1

# ---- Local skills directory ----
# Installed skills are written here. Defaults to ~/.skillforge/skills
SKILLFORGE_SKILLS_DIR=~/.skillforge/skills

# ---- Backend ----
SKILLFORGE_API_HOST=0.0.0.0
SKILLFORGE_API_PORT=8000

# ---- Web UI ----
# URL the browser uses to reach the API. Set when served behind a proxy.
SKILLFORGE_WEB_API_URL=http://localhost:8000

# ---- Database ----
# SQLite path (relative to the api app working dir). Defaults to skillforge.db
SKILLFORGE_DB_PATH=skillforge.db

# ---- Eval harness ----
# Hard cap on (skill × prompt) completions per eval run, to guard spend.
SKILLFORGE_EVAL_MAX_CALLS=50
