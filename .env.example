# =============================================================================
# SkillForge environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# All secrets are read from environment variables only.
# =============================================================================

# ---- AI Provider ----
# One of: openai-compatible | ollama-local | mock
SKILLFORGE_AI_PROVIDER=mock

# ---- OpenAI-compatible provider ----
SKILLFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
SKILLFORGE_OPENAI_API_KEY=your_api_key_here
SKILLFORGE_MODEL=gpt-4.1

# ---- Ollama (local LLM) ----
SKILLFORGE_OLLAMA_BASE_URL=http://localhost:11434
# When using ollama, set SKILLFORGE_MODEL to a pulled model e.g. llama3.1
# SKILLFORGE_MODEL=llama3.1

# ---- Local skills directory ----
# Installed skills are written here. Defaults to ~/.skillforge/skills
SKILLFORGE_SKILLS_DIR=~/.skillforge/skills

# ---- Backend ----
SKILLFORGE_API_HOST=0.0.0.0
SKILLFORGE_API_PORT=8000

# ---- Web UI ----
# URL the browser uses to reach the API. Set when served behind a proxy.
SKILLFORGE_WEB_API_URL=http://localhost:8000

# ---- Database ----
# SQLite path (relative to the api app working dir). Defaults to skillforge.db
SKILLFORGE_DB_PATH=skillforge.db
